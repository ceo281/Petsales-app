# All keys are optional. A missing key switches its checks off, the page
# shows them as "coming soon" and the check count drops to match.
# On Replit, add these under Tools > Secrets (never commit real values).

# Serper.dev (https://serper.dev): Google web search and Google Lens.
# Turns on copied-wording, phone/email/name, Facebook/Instagram checks,
# and the photo search for ads read from a link or the bookmark.
SERPER_API_KEY=

# Optional: Google Cloud Vision. Only needed to photo-search images that
# buyers upload themselves (Serper's Lens needs a public photo link).
GOOGLE_VISION_API_KEY=

# ABN Lookup web services GUID (free): https://abr.business.gov.au/Tools/WebServices
ABR_GUID=
