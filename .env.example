# All keys are optional. Each missing key just switches that check off
# (the report shows it as "not run" and the confidence figure drops).

# Reverse image search — Google Cloud Vision API (Web Detection feature)
# https://cloud.google.com/vision/docs/detecting-web
GOOGLE_VISION_API_KEY=

# Web / text / name / phone / social search — Brave Search API
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ABN Lookup web services GUID (free) — https://abr.business.gov.au/Tools/WebServices
ABR_GUID=
